{
  "name": "wallbook",
  "version": "1.0.0",
  "productName": "Wallbook",
  "description": "Wallpaper selector for macOS workspaces",
  "author": "Wallbook",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "typecheck": "bun check",
    "build": "electron-builder --mac --win --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.wallbook.app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "desktop-wallpaper.js",
      "app/**/*",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
